{
  "name": "pi-btw",
  "version": "0.62.0",
  "description": "Pi extension: ask side questions about a running agent without adding them to the main conversation.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "gold_silver_copper",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "btw",
    "side-question"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "fuzz": "FUZZ_RUNS=2000 vitest run test/fuzz",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gold-silver-copper/pi-btw.git"
  }
}
